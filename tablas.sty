\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tablas}[2026/11/09 Soporte para tablas de informe]
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{pdflscape}
\RequirePackage{caption}
\captionsetup[table]{position=top,justification=raggedright,singlelinecheck=false}
\newcommand{\notaTabla}[1]{\par\vspace{9pt}\noindent{\small #1}\par}
\newcommand{\fuenteTabla}[1]{\notaTabla{Fuente: #1}}
% Todas las tablas deben respetar el ancho del bloque de texto o \linewidth.
% Las tablas horizontales requieren comprobacion visual de orientacion y numero de pagina.
